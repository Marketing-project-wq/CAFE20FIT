# Custom Caddyfile for Railway (Railpack uses this instead of its default).
# Railpack's default sends a strict Content-Security-Policy without blob:
# or 'unsafe-eval', which blocks the bundled page's runtime scripts and
# leaves raw {{ ... }} placeholders on screen. This config keeps the other
# security headers but omits that CSP.
{
	admin off
	persist_config off
	auto_https off

	log {
		format json
	}

	servers {
		trusted_proxies static private_ranges
	}
}

:{$PORT:80} {
	log {
		format json
	}

	respond /health 200

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Always revalidate the page so new uploads show up without a hard refresh
	header /index.html Cache-Control "no-cache"
	header / Cache-Control "no-cache"

	root * /app

	file_server {
		hide .git
		hide .env*
		hide Caddyfile
		hide Staticfile
		hide /app/tools
	}

	encode {
		gzip
		zstd
	}

	try_files {path} {path}.html {path}/index.html /index.html
}
